{
    "name": "timot/todo-items",
    "description": "A file-backed TODO list for repositories worked by several agents at once: one item per file, a generated index, ids that never collide across branches, and claims so two agents don't start the same thing.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.2",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Timot\\TodoItems\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Timot\\TodoItems\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Timot\\TodoItems\\TodoItemsServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
